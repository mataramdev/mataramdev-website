# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors
.idea/
.vscode/

# design mockups kept next to the project for reference, not part of the repo
ui_design_canva/

# documentation & agent notes — sengaja tidak ikut di-commit (permintaan pemilik)
/docs/
/AGENTS.md
/CLAUDE.md

# local tooling state (symlink ke ~/.omo/codegraph) — breaks Turbopack's CSS loader if scanned
# tanpa garis miring: pola `.codegraph/` hanya cocok dengan direktori, sedangkan ini symlink
.codegraph
.codegraph.db
# agent session state written next to the project by local tooling
.omo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template with placeholders is meant to be committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
